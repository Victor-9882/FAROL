# Variáveis de ambiente do FAROL (IC-08).
# Copie para .env e ajuste:   cp .env.example .env
# O .env nunca é versionado. Aqui só há valores de desenvolvimento, nenhum segredo real.

# --- Django ---------------------------------------------------------------
# Gere uma chave com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (serviço "db" do Docker Compose) ----------------------------
POSTGRES_USER=farol
POSTGRES_PASSWORD=farol
POSTGRES_DB=farol

# Usado ao rodar `uv run ...` direto na máquina. Dentro do Compose,
# o docker-compose.yml troca "localhost" por "db".
DATABASE_URL=postgres://farol:farol@localhost:5432/farol

# --- E-mail (Mailpit) -------------------------------------------------------
# Dentro do Compose, o docker-compose.yml troca "localhost" por "mailpit".
# Sem EMAIL_URL, os e-mails só aparecem no console.
EMAIL_URL=smtp://localhost:1025
DEFAULT_FROM_EMAIL="FAROL <farol@localhost>"
