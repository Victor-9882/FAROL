# Variáveis de ambiente do FAROL (IC-08).
# Copie para .env e ajuste:   cp .env.example .env
# O .env nunca é versionado. Aqui só há valores de desenvolvimento, nenhum segredo real.

# --- Django ---------------------------------------------------------------
# Gere uma chave com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (serviço "db" do Docker Compose) ----------------------------
POSTGRES_USER=farol
POSTGRES_PASSWORD=farol
POSTGRES_DB=farol

# Usado ao rodar `uv run ...` direto na máquina. Dentro do Compose,
# o docker-compose.yml troca "localhost" por "db".
DATABASE_URL=postgres://farol:farol@localhost:5432/farol

# --- E-mail (Mailpit) -------------------------------------------------------
# Dentro do Compose, o docker-compose.yml troca "localhost" por "mailpit".
# Sem EMAIL_URL, os e-mails só aparecem no console.
EMAIL_URL=smtp://localhost:1025
DEFAULT_FROM_EMAIL="FAROL <farol@localhost>"

# Máximo de linhas de dados por arquivo de importação (NF025).
IMPORTACAO_LIMITE_LINHAS=5000

# Login: limite de tentativas erradas por usuário e tempo de bloqueio (RF001, NF013)
# LOGIN_LIMITE_TENTATIVAS=5
# LOGIN_BLOQUEIO_MINUTOS=15

# Sessão e HTTPS (RF001, NF013, NF014; ver docs/seguranca.md).
# O modo HTTPS (cookies seguros, redirecionamento e HSTS) segue o padrão "not DJANGO_DEBUG":
# fica desligado com DJANGO_DEBUG=True, como acima. Em produção, use DJANGO_DEBUG=False e gere
# a DJANGO_SECRET_KEY com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# DJANGO_HTTPS=False
# Duração da sessão em segundos (padrão 28800 = 8 horas; deve ser maior que zero)
# DJANGO_SESSION_COOKIE_AGE=28800
# A sessão também termina ao fechar o navegador (padrão True)
# DJANGO_SESSION_EXPIRE_AT_BROWSER_CLOSE=True
# HSTS em segundos, só com HTTPS ligado (padrão 2592000 = 30 dias)
# DJANGO_SECURE_HSTS_SECONDS=2592000
# Só atrás de proxy que termina o TLS e sobrescreve X-Forwarded-Proto (padrão False)
# DJANGO_SECURE_PROXY_SSL_HEADER=False
# Origens https confiáveis, separadas por vírgula
# DJANGO_CSRF_TRUSTED_ORIGINS=https://farol.exemplo.org
